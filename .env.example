# Buffering & cache (defaults shown)
# SEGMENT_CACHE_MAX_MB=2048
# SEGMENT_CACHE_MAX_ENTRIES=5000
# SEGMENT_CACHE_TTL_MS=7200000
# SEGMENT_PLAYLIST_TTL_MS=1800000
# SEGMENT_PREFETCH_AHEAD_SECONDS=240   # how far ahead of the playhead to download (very large = whole episode)
# SEGMENT_PREFETCH_CONCURRENCY=4       # parallel prefetch downloads
# SEGMENT_FETCH_RETRIES=3
# SEGMENT_HEADERS_TIMEOUT_MS=10000
# SEGMENT_BODY_TIMEOUT_MS=15000
# SEGMENT_NEXT_EPISODE_SECONDS=60      # how much of the next episode to pre-download near the end
# SEGMENT_CACHE_PREFETCH=3             # fallback prefetch count for segments not in a known playlist
# STREAM_CACHE_TTL_MS=1200000          # cache stream lists so reopening a title is instant
# SELFSTREAM_LOCAL_PORT=7000

# Surfshark WireGuard via Gluetun (only used with compose.vpn.yaml)
# SURFSHARK_WIREGUARD_PRIVATE_KEY=           # required: Surfshark dashboard > Manual setup > WireGuard
# SURFSHARK_WIREGUARD_ADDRESSES=10.14.0.2/16
# SURFSHARK_WIREGUARD_MTU=1280
# SURFSHARK_SERVER_COUNTRIES=Italy           # pick the closest country for lowest latency
# SURFSHARK_SERVER_CITIES=Milan
